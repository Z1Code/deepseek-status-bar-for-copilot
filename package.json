{
  "name": "deepseek-status-bar-for-copilot",
  "displayName": "DeepSeek Status Bar for Copilot",
  "description": "%description%",
  "version": "0.3.1",
  "publisher": "zxzxo",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Z1Code/deepseek-status-bar-for-copilot.git"
  },
  "keywords": [
    "deepseek",
    "deepseek v4",
    "usage",
    "cost",
    "tokens",
    "status bar",
    "api",
    "proxy",
    "copilot"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionDependencies": [
    "Vizards.deepseek-v4-for-copilot"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "deepseekStatusBar.showStats",
        "title": "%command.showStats%"
      },
      {
        "command": "deepseekStatusBar.toggleProxy",
        "title": "%command.toggleProxy%"
      },
      {
        "command": "deepseekStatusBar.statusBarFormat",
        "title": "%command.statusBarFormat%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "deepseekStatusBar.toggleProxy",
          "title": "%command.proxyStart%",
          "when": "!deepseekStatusBar.proxyRunning"
        },
        {
          "command": "deepseekStatusBar.toggleProxy",
          "title": "%command.proxyStop%",
          "when": "deepseekStatusBar.proxyRunning"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "deepseekStatusBar.port": {
          "type": "number",
          "default": 8080,
          "description": "%config.port%"
        },
        "deepseekStatusBar.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoStart%"
        },
        "deepseekStatusBar.manageBaseUrl": {
          "type": "boolean",
          "default": true,
          "description": "%config.manageBaseUrl%"
        },
        "deepseekStatusBar.pollIntervalSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "description": "%config.pollIntervalSeconds%"
        },
        "deepseekStatusBar.statusBarFormat": {
          "type": "string",
          "enum": [
            "full",
            "cost",
            "tokens",
            "totalT",
            "totalCost",
            "balance"
          ],
          "default": "full",
          "description": "%config.statusBarFormat%"
        },
        "deepseekStatusBar.pricing": {
          "type": "object",
          "default": {},
          "description": "%config.pricing%"
        },
        "deepseekStatusBar.currency": {
          "type": "string",
          "enum": [
            "cny",
            "usd"
          ],
          "default": "cny",
          "description": "%config.currency%"
        },
        "deepseekStatusBar.cnyPerUsd": {
          "type": "number",
          "default": 6.74,
          "description": "%config.cnyPerUsd%"
        },
        "deepseekStatusBar.lowBalanceWarnCny": {
          "type": "number",
          "default": 10,
          "description": "%config.lowBalanceWarnCny%"
        }
      }
    }
  },
  "scripts": {
    "compile": "node build.js",
    "watch": "node build.js --watch",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild smoke.ts --bundle --format=cjs --platform=node --outfile=out/smoke.js && node out/smoke.js",
    "test": "esbuild test.ts --bundle --format=cjs --platform=node --outfile=out/test.js --alias:vscode=./test/vscodeStub.ts && node out/test.js",
    "vscode:prepublish": "node build.js --production"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.23"
  }
}
